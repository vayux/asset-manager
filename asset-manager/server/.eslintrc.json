{
  "root": true,
  "env": {
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022
  },
  "extends": [
    "eslint:recommended"
  ],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "args": "none"
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "tests/**/*.js"
      ],
      "plugins": [
        "jest"
      ],
      "env": {
        "jest/globals": true
      },
      "extends": [
        "plugin:jest/recommended"
      ]
    }
  ]
}
