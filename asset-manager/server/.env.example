# Copy to server/.env and fill in. Never commit the real .env.
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:3000
# Set to the number of proxies in front of the API (e.g. 1 behind nginx/a load balancer)
TRUST_PROXY=
APP_TIMEZONE=Asia/Kolkata

DB_HOST=localhost
DB_PORT=5432
DB_NAME=asset_manager
DB_USER=postgres
DB_PASSWORD=password

# Required; the server refuses to start without them. Generate each with `openssl rand -hex 32`.
# JWT_SECRET signs 15-minute access tokens (at least 32 characters).
JWT_SECRET=
# MFA_ENCRYPTION_KEY encrypts TOTP secrets and keys backup-code hashes (exactly 64 hex characters).
# Changing it invalidates every user's 2FA setup.
MFA_ENCRYPTION_KEY=
JWT_EXPIRE=15m
# Refresh sessions live in an httpOnly cookie; defaults to Secure only when NODE_ENV=production
SESSION_TTL_DAYS=7
COOKIE_SECURE=
LOG_LEVEL=info

BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email (optional). Any SMTP server via EMAIL_*, or Gmail via GMAIL_USER + GMAIL_APP_PASSWORD.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Take one portfolio/net-worth snapshot per user per day (set to false to disable)
AUTO_SNAPSHOTS=true

# Document attachments (PDF/PNG/JPEG/WebP, max 10 MB). With SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY set,
# files go to a private Supabase Storage bucket; otherwise they are written to UPLOAD_DIR on the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=attachments
UPLOAD_DIR=
