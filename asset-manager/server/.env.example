# Copy to server/.env and fill in. Never commit the real .env.
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:3000
# Set to the number of proxies in front of the API (e.g. 1 behind nginx/a load balancer)
TRUST_PROXY=
APP_TIMEZONE=Asia/Kolkata

DB_HOST=localhost
DB_PORT=5432
DB_NAME=asset_manager
DB_USER=postgres
DB_PASSWORD=password

# Two different random values of at least 32 characters, e.g. `openssl rand -hex 32`.
# The server refuses to start without them.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email (optional). Any SMTP server via EMAIL_*, or Gmail via GMAIL_USER + GMAIL_APP_PASSWORD.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
GMAIL_USER=
GMAIL_APP_PASSWORD=
